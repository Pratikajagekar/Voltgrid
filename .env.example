# Local development: leave DATABASE_URL and RENDER_DISK_PATH unset to use ./evcharge.db.
# Render PostgreSQL (recommended):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE
#
# Render Persistent Disk mount path (required for persistent local uploads;
# also stores SQLite when DATABASE_URL is not configured):
# RENDER_DISK_PATH=/var/data
#
# Set a long random value and keep it stable between deployments:
EVCHARGE_SECRET_KEY=replace-with-a-long-random-secret
